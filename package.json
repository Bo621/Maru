{
  "name": "@maru/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run && pnpm test:core-sync",
    "test:core-sync": "./scripts/check_core_sync.sh",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "E2E_SMOKE=1 playwright test --grep @smoke",
    "check:onchain": "node scripts/check_docs_onchain.mjs",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-4173}"
  },
  "dependencies": {
    "@poi/core": "workspace:*",
    "blo": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
